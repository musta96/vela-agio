// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`Landing Features grid — visual regression snapshots > snapshot at desktop (1280px) covers all 22 cards > features-grid-desktop 1`] = `"<section aria-labelledby="features-heading"><h2 id="features-heading">Everything you need to research the markets</h2><ul class="grid grid-cols-3 lg:grid-cols-4 gap-6" data-testid="features-grid"><li data-icon="Brain"><h3>AI Research Copilot</h3><p>Ask anything about a stock, sector or your portfolio. Get cited, jargon-free answers powered by the latest LLMs.</p></li><li data-icon="Sparkles"><h3>AI Radar &amp; Idea Lab</h3><p>AI scanners, smart picks and stocks-to-watch surface high-conviction ideas across thousands of instruments every day.</p></li><li data-icon="LineChart"><h3>Live Markets &amp; Charts</h3><p>FTSE MIB, pan-European, US stocks, ETFs, FX, commodities and crypto. Real-time quotes, intraday, VWAP and 50+ technical indicators.</p></li><li data-icon="Globe"><h3>Explore, Movers &amp; Sectors</h3><p>Curated discovery rails, sector heatmaps, thematic watchlists and top movers across every covered market.</p></li><li data-icon="TrendingUp"><h3>Options &amp; Futures</h3><p>Options chains, futures curves, credit spreads and bond calculator for derivatives-aware research.</p></li><li data-icon="Newspaper"><h3>Filings, Earnings &amp; Insider</h3><p>SEC/CONSOB filings, earnings calendar, insider transactions, buybacks and corporate actions in one feed.</p></li><li data-icon="Activity"><h3>Sentiment &amp; News</h3><p>AI-summarised filings, earnings calls and social sentiment so you spot signals before the crowd.</p></li><li data-icon="PieChart"><h3>Portfolio &amp; Orders</h3><p>Manual or broker-connected portfolios with orders, blotter, paper trading and short-selling analytics.</p></li><li data-icon="Wallet"><h3>Net Worth &amp; Household</h3><p>Track cash, investments, retirement, crypto, real estate, vehicles, collectibles and liabilities across the household.</p></li><li data-icon="Target"><h3>Goals, Budget &amp; Dividend Planner</h3><p>Set financial goals, run a monthly budget and forecast dividend income with reinvestment scenarios.</p></li><li data-icon="PieChart"><h3>Portfolio Coach &amp; Advisor</h3><p>Continuous, plain-English suggestions on rebalancing, risk, diversification and factor exposures.</p></li><li data-icon="Repeat"><h3>Backtesting &amp; Strategy Lab</h3><p>Design, backtest and walk-forward optimise strategies with transaction costs, slippage and regime breakdowns.</p></li><li data-icon="BarChart3"><h3>Optimizer &amp; Rebalance</h3><p>Mean-variance, risk-parity and factor-tilt optimisers, plus one-click rebalance plans for any portfolio.</p></li><li data-icon="Shield"><h3>Risk Engine &amp; Simulations</h3><p>VaR/CVaR, Monte Carlo simulations, drawdown analytics and stress tests across market regimes.</p></li><li data-icon="FlaskConical"><h3>Quant Alpha &amp; Event Study</h3><p>Institutional-grade quant factors, event studies, peer analysis, ETF overlap and 13F replication.</p></li><li data-icon="Bell"><h3>Smart Alerts &amp; Signals</h3><p>Price, technical, fundamental and news alerts via email, push or webhook. Never miss what matters.</p></li><li data-icon="Receipt"><h3>Tax, Reports &amp; Corp. Actions</h3><p>Tax-loss harvesting, corporate-action tracking, one-click PDF reports and a tamper-evident audit log.</p></li><li data-icon="ShieldCheck"><h3>Suitability &amp; MiFID II</h3><p>Advisor seats, client mandates, MiFID II suitability questionnaires, KIDs and audit-ready trails.</p></li><li data-icon="Building2"><h3>Deal Flow &amp; Related Graph</h3><p>Deal-flow feed, related-instruments graph and thematic drill-downs for research-driven investors.</p></li><li data-icon="BookOpen"><h3>Learn, Methodology &amp; Onboarding</h3><p>Guided onboarding, an in-app academy and transparent methodology pages behind every score and model.</p></li><li data-icon="Link2"><h3>Agent Integrations (MCP) &amp; API</h3><p>OAuth-protected MCP server plus REST and WebSocket access for AI agents and internal research pipelines.</p></li><li data-icon="Lock"><h3>Security, Privacy &amp; Audit</h3><p>EU-hosted, encrypted, RLS-protected, with row-level audit logs, GDPR export and account deletion built in.</p></li></ul></section>"`;

