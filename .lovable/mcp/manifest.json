{
  "version": 1,
  "sdk_version": "0.22.2",
  "path": "/functions/v1/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://pcisxjfgdrgpxzfzfscf.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "vela",
      "version": "1.0.0",
      "title": "Vela — Trading Strategy Platform"
    },
    "tools": [
      {
        "name": "get_quote",
        "title": "Get quote",
        "description": "Latest price and daily change for a Yahoo-style ticker (e.g. AAPL, ENI.MI, ASML.AS). Public market data — no auth required.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": true
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "symbol": {
              "type": "string",
              "minLength": 1,
              "description": "Yahoo-style ticker symbol, e.g. AAPL, ENI.MI"
            }
          },
          "required": [
            "symbol"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "search_strategies",
        "title": "Search strategies",
        "description": "Search Vela's strategy library by free-text query (name, category, risk, horizon). Public — no auth required.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "query": {
              "default": "",
              "description": "Free-text query, e.g. \"momentum\", \"mean reversion\", \"low risk\"",
              "type": "string"
            },
            "limit": {
              "default": 10,
              "description": "Max results (1–50)",
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "get_watchlist",
        "title": "Get watchlist",
        "description": "Return the signed-in Vela user's watchlist items (symbol, name, added-at).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "get_portfolio",
        "title": "Get portfolio",
        "description": "Return the signed-in Vela user's portfolio holdings (symbol, shares, avg price, currency).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "get_net_worth",
        "title": "Get net worth summary",
        "description": "Return the signed-in Vela user's net-worth accounts with totals for assets, liabilities and net. Values are in each account's stored currency (no FX conversion).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "list_cash_flow",
        "title": "List cash flow entries",
        "description": "Return the signed-in user's cash flow entries (income/expense), most recent first. Optional `limit` (default 100, max 500).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "limit": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991,
              "description": "Max entries to return (default 100, capped at 500)."
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "add_cash_flow_entry",
        "title": "Add cash flow entry",
        "description": "Record an income or expense for the signed-in user. Use `recurring_monthly: true` for fixed monthly bills or salary — Vela will project it forward automatically.",
        "annotations": {
          "readOnlyHint": false,
          "idempotentHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "direction": {
              "type": "string",
              "enum": [
                "income",
                "expense"
              ],
              "description": "Whether this is income or an expense."
            },
            "category": {
              "type": "string",
              "description": "Category label (e.g. Salary, Housing, Food, Subscriptions)."
            },
            "amount": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "Positive amount in the entry's currency."
            },
            "entry_date": {
              "type": "string",
              "description": "Date in YYYY-MM-DD; defaults to today when omitted."
            },
            "currency": {
              "type": "string",
              "description": "3-letter currency code (default EUR)."
            },
            "label": {
              "type": "string",
              "description": "Optional short note, e.g. 'Rent', 'Employer'."
            },
            "recurring_monthly": {
              "type": "boolean",
              "description": "True if this repeats every month."
            }
          },
          "required": [
            "direction",
            "category",
            "amount"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "project_dividends",
        "title": "Project future dividend income",
        "description": "Model annual dividend income for a given horizon using contributions, dividend yield, dividend growth, price appreciation, tax rate and optional DRIP. Accepts an optional `positions` array to seed the starting value and blended yield from real holdings. Returns per-year rows (portfolio value, gross/net dividends, yield on cost) plus totals.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "starting_value": {
              "type": "number",
              "description": "Starting portfolio value in the projection currency."
            },
            "monthly_contribution": {
              "type": "number",
              "description": "Monthly cash added to the portfolio."
            },
            "contribution_growth_pct": {
              "type": "number",
              "description": "Annual growth of monthly contributions in percent."
            },
            "dividend_yield_pct": {
              "type": "number",
              "description": "Starting annual dividend yield in percent."
            },
            "dividend_growth_pct": {
              "type": "number",
              "description": "Annual dividend growth rate in percent (DGR)."
            },
            "price_growth_pct": {
              "type": "number",
              "description": "Annual price appreciation in percent."
            },
            "tax_pct": {
              "type": "number",
              "description": "Dividend withholding/income tax rate in percent."
            },
            "years": {
              "type": "number",
              "description": "Projection horizon in years."
            },
            "reinvest": {
              "type": "boolean",
              "description": "If true, net dividends buy new shares (DRIP)."
            },
            "payout_frequency": {
              "type": "number",
              "description": "Payouts per year: 1, 2, 4 or 12."
            },
            "reinvest_rate_pct": {
              "description": "Optional global DRIP rate 0-100 overriding `reinvest`. Ignored if any position sets `drip_pct`.",
              "type": "number"
            },
            "positions": {
              "description": "Optional real holdings. When provided, seed the starting value and blended yield from these positions.",
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "symbol": {
                    "type": "string"
                  },
                  "shares": {
                    "type": "number"
                  },
                  "price": {
                    "type": "number"
                  },
                  "yield_pct": {
                    "type": "number"
                  },
                  "next_payout_month": {
                    "type": "number"
                  },
                  "drip_pct": {
                    "type": "number"
                  }
                },
                "required": [
                  "symbol",
                  "shares",
                  "price",
                  "yield_pct"
                ]
              }
            }
          },
          "required": [
            "starting_value",
            "monthly_contribution",
            "contribution_growth_pct",
            "dividend_yield_pct",
            "dividend_growth_pct",
            "price_growth_pct",
            "tax_pct",
            "years",
            "reinvest",
            "payout_frequency"
          ]
        },
        "outputSchema": null
      }
    ]
  }
}
