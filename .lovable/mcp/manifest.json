        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "get_portfolio",
        "title": "Get portfolio",
        "description": "Return the signed-in Vela user's portfolio holdings (symbol, shares, avg price, currency).",
